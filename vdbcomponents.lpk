<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <Name Value="vdbcomponents"/>
    <Type Value="RunTime"/>
    <Author Value="VDb"/>
    <CompilerOptions>
      <Version Value="11"/>
      <SearchPaths>
        <OtherUnitFiles Value="$(PkgDir);$(LazarusDir)/components/lazutils/lib/$(TargetCPU)-$(TargetOS)"/>
        <UnitOutputDirectory Value="lib/$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
    </CompilerOptions>
    <Description Value="VDb motoru icin TDataSet baglantisi (TVDbQuery). RunTime: uygulamalar bagimlilik olarak kullanir. Palet icin IDE'de RunAndDesignTime secilir."/>
    <License Value="Modified LGPL-2"/>
    <Version Major="1"/>
    <RequiredPackages>
      <Item>
        <PackageName Value="FCL"/>
      </Item>
      <Item>
        <PackageName Value="LazUtils"/>
      </Item>
    </RequiredPackages>
    <Files>
      <Item>
        <Filename Value="VDbDataSet.pas"/>
        <UnitName Value="VDbDataSet"/>
      </Item>
      <Item>
        <Filename Value="VDbDataSetReg.pas"/>
        <UnitName Value="VDbDataSetReg"/>
        <HasRegisterProc Value="True"/>
      </Item>
      <Item>
        <Filename Value="VDbPool.pas"/>
        <UnitName Value="VDbPool"/>
      </Item>
    </Files>
  </Package>
</CONFIG>
