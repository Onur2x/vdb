program autoincc;

{ R4 + D-Y4 dogrulamasi: AutoInc oturum yalitimi ve Int64 tasmasi.

  R4: TVTableDb.RestoreSchemaSnapshot paylasimli sema yedegini geri
  yuklerken AutoInc sayaclarini da ESKI degerine donduruyordu. A oturumu
  BEGIN (sema yedegi alinir), B oturumu ayni tabloya INSERT edip sayaci
  ilerletir, A ROLLBACK ederse B'nin ilerlettigi sayac eziliyordu; sonraki
  INSERT daha once dagitilmis bir identity degerini IKINCI kez verebiliyordu.
  (Satir hala duruyorsa cakisma denetimi degeri kurtarir; asil kanit,
  dagitilan satir silindikten sonra yapilan INSERT'tir: eski kod degeri
  yeniden dagitir.)

  Cozum: AutoInc MONOTON bir sayactir; geri alma DUSUREMEZ. Restore
  sirasinda her tablo icin max(mevcut, yedekteki) uygulanir. Geri alinan
  islemin urettigi degerler yalnizca bosluk birakir.

  D-Y4: AutoIncOf(T)+1 / MaxPkInt(T)+1 Isaretli Int64 tasmasinda sessizce
  sarardi. Artik sinirda ACIK hata (ecLimit) verilir.

  Senaryo:
    1) t(id BY DEFAULT IDENTITY, v): A BEGIN; B INSERT+COMMIT (id=1);
       B DELETE id=1 (dagitilmis deger artik satirda yok); A ROLLBACK;
       C INSERT -> id=2 olmali (1 degeri ikinci kez dagitilmamali).
    2) Yeniden acilis sonrasi INSERT -> sayac korunmus olmali (2,3).
    3) ov(id BY DEFAULT IDENTITY, v): acik id=Int64 max yazilir; sonraki
       otomatik INSERT tasma hatasi vermeli (sessiz sarma YOK).

  Cikis: 0 = gecti, 1 = kaldi. Kullanim: autoincc <dizin>
}

{$mode delphi}{$H+}

uses
  {$IFDEF UNIX}cthreads,{$ENDIF}
  Classes, SysUtils,
  VDbBackendApi, VDbCore, VDbBackendV3, VDbTable, VDbSql;

var
  gDir: string;
  nOk, nBad: Integer;

procedure Ok(const S: string);
begin
  Inc(nOk);
  WriteLn('  TAMAM: ', S);
end;

procedure Bad(const S, Detail: string);
begin
  Inc(nBad);
  if Detail <> '' then
    WriteLn('  *** UYUSMAZLIK: ', S, ' | ', Detail)
  else
    WriteLn('  *** UYUSMAZLIK: ', S);
end;

procedure Chk(const Cond: Boolean; const Title, Detail: string);
begin
  if Cond then Ok(Title) else Bad(Title, Detail);
end;

function DirOf(const N: string): string;
begin
  Result := IncludeTrailingPathDelimiter(gDir) + N;
end;

{ v3.23 guvenlik: depo kokunu supurme (bkz. backendchk CleanDir). }
procedure CleanDir;
var
  sr: TSearchRec;
  base: string;
begin
  if gDir = '' then Exit;
  if FileExists(IncludeTrailingPathDelimiter(gDir) + 'VDbCore.pas') then Exit;
  base := IncludeTrailingPathDelimiter(gDir);
  if FindFirst(base + '*', faAnyFile, sr) = 0 then
  begin
    repeat
      if (sr.Name <> '.') and (sr.Name <> '..') then
        if (sr.Attr and faDirectory) = 0 then
          DeleteFile(base + sr.Name);
    until FindNext(sr) <> 0;
    FindClose(sr);
  end;
end;

type
  TV3 = record
    Be: IVdbBackend;
    Tb: TVTableDb;
  end;

procedure OpenDb(out S: TV3; const Name: string; Create_: Boolean);
begin
  S.Be := TVdbBackendV3.Create(DirOf(Name), Create_, 64);
  S.Tb := TVTableDb.CreateBackend(S.Be);
  S.Tb.Open(gDir);
end;

procedure CloseDb(var S: TV3);
begin
  if S.Tb <> nil then
  begin
    try
      S.Tb.Close;
    except
      { kapanis hatasi test sonucunu golgelemesin }
    end;
    FreeAndNil(S.Tb);
  end;
  S.Be := nil;
end;

var
  gErr: Boolean;
  gMsg: string;

function Exec(Sq: TVSql; const Sql: string): TSqlResult;
begin
  gErr := False;
  gMsg := '';
  try
    Result := Sq.Exec(Sql);
  except
    on E: Exception do
    begin
      gErr := True;
      gMsg := E.ClassName + ': ' + E.Message;
      Result.Fields := nil;
      Result.Rows := nil;
      Result.Affected := 0;
      Result.Stmts := 0;
      Result.Msg := gMsg;
    end;
  end;
end;

function Cell(const R: TSqlResult; Row, Col: Integer): string;
begin
  if (Row < 0) or (Row > High(R.Rows)) or
     (Col < 0) or (Col > High(R.Rows[Row])) then
    Result := '<yok>'
  else
    Result := R.Rows[Row][Col];
end;

function Ids(const R: TSqlResult): string;
var
  i: Integer;
begin
  Result := '';
  for i := 0 to High(R.Rows) do
  begin
    if i > 0 then Result := Result + ',';
    Result := Result + Cell(R, i, 0);
  end;
end;

{ ---------------------------------------------------------------- R4 }
procedure TestRollbackIsolation;
var
  S: TV3;
  A, B, C: TVSql;
  r: TSqlResult;
  idlist: string;
begin
  WriteLn;
  WriteLn('1) R4: ROLLBACK baska oturumun AutoInc artisini ezmemeli');
  OpenDb(S, 'iso.db', True);
  A := TVSql.Create(S.Tb);
  B := TVSql.Create(S.Tb);
  C := TVSql.Create(S.Tb);
  try
    r := Exec(A, 'CREATE TABLE t(id INTEGER GENERATED BY DEFAULT AS IDENTITY, v TEXT)');
    Chk(not gErr, 'R4 tablo olusturuldu', r.Msg);

    { A sema yedegini alir (BEGIN -> SnapshotSchema). }
    r := Exec(A, 'BEGIN');
    Chk(not gErr, 'R4 A BEGIN (yedek alindi)', r.Msg);

    { B ayni tabloya yazar ve commit eder: sayac ilerler. }
    r := Exec(B, 'BEGIN');
    Chk(not gErr, 'R4 B BEGIN', r.Msg);
    r := Exec(B, 'INSERT INTO t(v) VALUES(''b1'')');
    Chk(not gErr, 'R4 B INSERT (id=1 beklenir)', r.Msg);
    r := Exec(B, 'COMMIT');
    Chk(not gErr, 'R4 B COMMIT', r.Msg);

    { Dagitilan satiri sil: geri alma sayaci dusururse 1 degeri yeniden
      dagitilabilir hale gelir (cakisma denetimi artik kurtaramaz). }
    r := Exec(B, 'DELETE FROM t WHERE id=1');
    Chk(not gErr, 'R4 B DELETE id=1', r.Msg);

    { A geri alir: sayac DUSMEMELI. }
    r := Exec(A, 'ROLLBACK');
    Chk(not gErr, 'R4 A ROLLBACK', r.Msg);

    { Yeni INSERT ayni degeri IKINCI kez dagitmamali: id=2 beklenir. }
    r := Exec(C, 'INSERT INTO t(v) VALUES(''c1'')');
    Chk(not gErr, 'R4 C INSERT', r.Msg);

    r := Exec(C, 'SELECT id FROM t ORDER BY id');
    idlist := Ids(r);
    Chk((not gErr) and (idlist = '2'),
      'R4 ayni identity degeri iki kez dagitilmadi (2)', 'gelen=' + idlist + ' ' + r.Msg);
  finally
    A.Free;
    B.Free;
    C.Free;
    CloseDb(S);
  end;

  { Yeniden acilis: sayac kalici ve tutarli olmali. }
  WriteLn;
  WriteLn('2) R4: yeniden acilis sonrasi sayac tutarli');
  OpenDb(S, 'iso.db', False);
  A := TVSql.Create(S.Tb);
  try
    r := Exec(A, 'INSERT INTO t(v) VALUES(''d1'')');
    Chk(not gErr, 'R4 yeniden acilis INSERT', r.Msg);
    r := Exec(A, 'SELECT id FROM t ORDER BY id');
    idlist := Ids(r);
    Chk((not gErr) and (idlist = '2,3'),
      'R4 yeniden acilis sonrasi sayac devam etti (2,3)', 'gelen=' + idlist + ' ' + r.Msg);
  finally
    A.Free;
    CloseDb(S);
  end;
end;

{ -------------------------------------------------------------- D-Y4 }
procedure TestOverflow;
const
  MAXI64 = '9223372036854775807';
var
  S: TV3;
  A: TVSql;
  r: TSqlResult;
  rolled: Boolean;
begin
  WriteLn;
  WriteLn('3) D-Y4: Int64 tasmasinda ACIK hata (sessiz sarma yok)');
  OpenDb(S, 'ov.db', True);
  A := TVSql.Create(S.Tb);
  try
    r := Exec(A, 'CREATE TABLE ov(id INTEGER GENERATED BY DEFAULT AS IDENTITY, v TEXT)');
    Chk(not gErr, 'D-Y4 tablo olusturuldu', r.Msg);

    { Acik deger sayaci sinirda baslatir (BY DEFAULT acik degeri kabul eder). }
    r := Exec(A, 'INSERT INTO ov(id,v) VALUES(' + MAXI64 + ',''max'')');
    Chk(not gErr, 'D-Y4 sayac Int64 sinirina ayarlandi', r.Msg);

    { Sonraki otomatik INSERT tasmali; ACIK hata beklenir. }
    r := Exec(A, 'INSERT INTO ov(v) VALUES(''next'')');
    rolled := gErr;
    Chk(rolled and (Pos('Int64 sinirina', gMsg) > 0),
      'D-Y4 tasmada acik hata verildi', gMsg);

    { Sessiz sarma olsaydi id negatife doner ve INSERT basarili olurdu. }
    r := Exec(A, 'SELECT COUNT(*) FROM ov');
    Chk((not gErr) and (Cell(r, 0, 0) = '1'),
      'D-Y4 tasma sonrasi satir eklenmedi', 'gelen=' + Cell(r, 0, 0) + ' ' + r.Msg);
  finally
    A.Free;
    CloseDb(S);
  end;
end;

begin
  if ParamCount < 1 then
  begin
    WriteLn(StdErr, 'kullanim: autoincc <dizin>');
    Halt(2);
  end;
  gDir := ParamStr(1);
  ForceDirectories(gDir);
  nOk := 0;
  nBad := 0;
  CleanDir;
  TestRollbackIsolation;
  TestOverflow;
  WriteLn;
  if nBad = 0 then
  begin
    WriteLn('AUTOINC OTURUM YALITIMI DOGRULANDI');
    WriteLn('SONUC: gecen=', nOk, ' kalan=0');
  end
  else
    WriteLn('SONUC: gecen=', nOk, ' kalan=', nBad);
  if nBad <> 0 then Halt(1);
  WriteLn('TEMIZ');
end.
